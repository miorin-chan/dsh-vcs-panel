{
  "name": "dsh-vcs-panel",
  "version": "0.1.3",
  "license": "MIT",
  "description": "Version control panel for DeepSeek Harness, in the right sidebar: working changes, their diffs, and history with a lane graph, for Git and Jujutsu repositories, plus Git branch, remote-branch, tag, and commit actions and one-click upstream sync.",
  "icon": "./icon.svg",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "vcs",
    "version-control",
    "git",
    "diff",
    "history",
    "jujutsu",
    "jj"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "NOTICE",
    "licenses",
    "README.md",
    "README.zh.md",
    "docs/README.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "CHANGELOG.md",
    "DESIGN.md",
    "IMPLEMENTATION.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "check": "node --test && node scripts/build.mjs --check"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
