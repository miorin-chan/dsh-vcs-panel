{
  "name": "@miorin/dsh-vcs-panel",
  "version": "0.1.3",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "description": "Version control panel for DeepSeek Harness, in the right sidebar: working changes, their diffs, and history with a lane graph, for Git and Jujutsu repositories, plus Git branch, remote-branch, tag, and commit actions and one-click upstream sync.",
  "icon": "./icon.svg",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "vcs",
    "version-control",
    "git",
    "diff",
    "history",
    "jujutsu",
    "jj"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "NOTICE",
    "licenses",
    "README.md",
    "README.zh.md",
    "docs/README.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "CHANGELOG.md",
    "DESIGN.md",
    "IMPLEMENTATION.md",
    "src",
    "scripts",
    "tsconfig.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build 1>&2",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:unit --",
    "test:unit": "node --test",
    "check": "npm run test:unit && npm run typecheck && node scripts/build.mjs --check && node scripts/sync-types.mjs --check"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.5",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.31",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "typescript": "5.7.3"
  }
}
